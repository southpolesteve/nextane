{
  "name": "nextane",
  "version": "0.1.1",
  "description": "Next.js without React. The Pages Router rebuilt on Octane.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/southpolesteve/nextane.git"
  },
  "homepage": "https://github.com/southpolesteve/nextane#readme",
  "bugs": {
    "url": "https://github.com/southpolesteve/nextane/issues"
  },
  "keywords": [
    "nextjs",
    "pages-router",
    "octane",
    "vite",
    "cloudflare-workers"
  ],
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "package-dist",
    "docs",
    "worker.ts",
    "worker.d.ts",
    "README.md",
    "MIGRATION_PROMPT.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:package": "node scripts/build-package.mjs",
    "prepack": "npm run build:package",
    "preview": "vite preview",
    "test": "vitest run",
    "test:release": "node --test scripts/test-next-release-version.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:package": "node scripts/test-package-install.mjs",
    "test:package:security": "npm run build:package && node scripts/verify-package-files.mjs",
    "test:workflow:security": "node scripts/test-workflow-security.mjs",
    "test:example": "node scripts/test-migrated-example.mjs",
    "test:upstream": "node scripts/upstream/run.mjs",
    "test:upstream:harness": "vitest run --config test/upstream/vitest.config.ts",
    "check": "npm run typecheck && npm run test && npm run test:release && npm run test:workflow:security && npm run test:e2e && npm run build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./package-dist/index.js"
    },
    "./head": {
      "types": "./src/runtime/head.d.ts",
      "default": "./src/runtime/head.tsrx"
    },
    "./document": {
      "types": "./src/runtime/document.d.ts",
      "default": "./src/runtime/document.tsrx"
    },
    "./link": {
      "types": "./src/runtime/link.d.ts",
      "default": "./src/runtime/link.tsrx"
    },
    "./router": {
      "types": "./src/runtime/router.d.ts",
      "default": "./src/runtime/router.ts"
    },
    "./navigation": {
      "types": "./src/runtime/app-navigation.d.ts",
      "default": "./src/runtime/app-navigation.ts"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.ts"
    },
    "./server": {
      "types": "./src/server/handler.d.ts",
      "default": "./src/server/handler.ts"
    },
    "./types": "./src/types.ts",
    "./worker": {
      "types": "./worker.d.ts",
      "default": "./worker.ts"
    }
  },
  "dependencies": {
    "@octanejs/vite-plugin": "0.1.21",
    "octane": "0.1.21"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20260730.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "undici": "7.29.0",
    "nanoid": "3.3.18"
  }
}
